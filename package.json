{
  "name": "tracehound",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic on-chain hack tracer: walks live transaction hops from a compromised address, flags known-risk addresses, and narrates the trace in plain English.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run mcp:build && node --test tests/*.test.mjs",
    "eval": "node evals/run.mjs",
    "update-watchlist": "node scripts/update-watchlist.js",
    "mcp:build": "tsc -p tsconfig.mcp.json",
    "mcp": "node dist/src/mcp/server.js",
    "mcp:smoke": "node scripts/mcp-smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "next": "16.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "fast-xml-parser": "^5.9.3",
    "typescript": "^5.5.0"
  }
}
